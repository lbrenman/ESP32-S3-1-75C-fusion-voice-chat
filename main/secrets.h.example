#pragma once
// Copy this file to secrets.h and fill in your values.
// secrets.h is gitignored. Do not commit it or paste it anywhere.

// Wi-Fi (ESP32-S3 supports 2.4 GHz networks only)
#define WIFI_SSID      "your-2.4GHz-network"
#define WIFI_PASSWORD  "your-wifi-password"

// Voice server. The client connects to:
//   wss://WS_HOST:WS_PORT WS_PATH ?x-api-key=WS_API_KEY &conversationId=<random uuid>
#define WS_HOST        "axway-appc-se-design.sandbox.fusion.services.axway.com"
#define WS_PORT        4443
#define WS_PATH        "/ws/speech"
#define WS_API_KEY     "your-api-key-here"
