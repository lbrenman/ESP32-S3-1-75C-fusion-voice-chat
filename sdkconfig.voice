
# ---- voice_chat additions (appended to Waveshare's sdkconfig.defaults) ----
# Fonts used by the UI
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# TLS for wss:// using the built-in CA bundle
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Keep internal RAM free for the display: let TLS, Wi-Fi and lwIP use PSRAM
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Keep internal RAM available for the display's DMA transfers. Waveshare's defaults reserve only
# 4 KB, so a full-screen repaint can fail with "Draw bitmap failed: ESP_ERR_NO_MEM".
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
